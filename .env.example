# ENTORNO
ENVIRONMENT=development

# API
API_PORT=8000

# APP
APP_NAME=Trading API
APP_VERSION=3.0.0
APP_DESCRIPTION=API completa para gestión de trades con autenticación JWT

# AUTH
ENCODE=utf-8

# COINGECKO
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=tu_api_key_coingecko

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# DATABASE
POSTGRES_USER=usuario
POSTGRES_PASSWORD=password
POSTGRES_DB=nombre_db
DATABASE_URL=postgresql://usuario:password@localhost:5432/nombre_db

# DATABASE TEST
TEST_DATABASE_URL=postgresql://usuario:password@localhost:5432/trading_test

# DEBUG
DEBUG=true

# JWT
SECRET_KEY=cambiar-por-una-clave-segura-en-produccion
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# RATE LIMIT Y PROTECCIÓN DEL LOGIN (todos opcionales; estos son los valores por defecto)
# Los comentarios van en líneas propias: docker-compose v1 no los quita si están después del valor.

# Peticiones por IP cada RATE_LIMIT_WINDOW segundos (cada conexión WebSocket nueva también cuenta)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
# POST /usuarios/login por IP y minuto
LOGIN_RATE_LIMIT=20
# POST /usuarios/registro por IP y hora
REGISTER_RATE_LIMIT=10
# Fallos por (IP, usuario) antes de bloquear el login; por usuario se permiten x4 y por IP x6
LOGIN_MAX_FAILURES=5
# Duración del bloqueo (y ventana en la que se cuentan los fallos), en segundos
LOGIN_LOCKOUT_SECONDS=900
# Cuántos proxies de confianza hay ENTRE el cliente y la app (Render, Railway, Cloudflare...). 0 = ninguno.
# Si está mal, todos los usuarios comparten un cupo o se puede falsificar la IP. Ver README.
TRUSTED_PROXY_COUNT=0
# Contadores compartidos entre instancias. Vacío = memoria del proceso (correcto con UNA sola instancia).
REDIS_URL=

# ------------------------------------------------------------------------------
# CHAT (/ws/chat; opcionales, valores por defecto)
# Mensajes permitidos por USUARIO cada CHAT_WINDOW_SECONDS segundos
CHAT_MAX_MESSAGES=10
CHAT_WINDOW_SECONDS=10
# Caracteres máximos por mensaje (si lo supera, se cierra la conexión)
CHAT_MAX_LENGTH=500
# Conexiones de chat simultáneas por usuario
CHAT_MAX_CONNECTIONS_PER_USER=3
